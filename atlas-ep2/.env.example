# Copiar como .env (no se sube al repositorio) y cambiar los valores.
# Secreto JWT en Base64 de al menos 32 bytes. Generar con:
#   Linux/Mac:  openssl rand -base64 32
#   Windows PowerShell:  [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
# Si se deja vacío, la API genera una clave aleatoria en cada arranque.
ATLAS_JWT_SECRET=
ATLAS_ADMIN_PASSWORD=Admin#Atlas2026
ATLAS_EDITOR_PASSWORD=Editor#Atlas2026
ATLAS_DATOS_DEMO=true
